# Copiar a .env.local (junto a package.json) y reiniciar Vite despues de cada cambio.

# Entra ID. Sin estos IDs se muestra el sitio publico, pero no hay inicio de sesion.
VITE_ENTRA_TENANT_ID=
VITE_SPA_CLIENT_ID=
VITE_API_CLIENT_ID=

# URL base de la API. Local: http://localhost:8080 (BFF). En AWS: https://<api-id>.execute-api.<region>.amazonaws.com (stage $default, sin /dev)
VITE_API_BASE_URL=
