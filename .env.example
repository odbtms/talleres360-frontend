# Copiar a .env.local (junto a package.json) y reiniciar Vite despues de cada cambio.

# Entra ID. Mientras esten vacios, la app funciona en "modo local" sin login real.
VITE_ENTRA_TENANT_ID=
VITE_SPA_CLIENT_ID=
VITE_API_CLIENT_ID=

# Backend. Hoy el micro de ordenes; despues la URL de AWS API Gateway.
VITE_API_BASE_URL=http://localhost:8081
